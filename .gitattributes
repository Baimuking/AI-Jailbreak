# 统一换行符，避免 autocrlf 带来的 diff 噪音
* text=auto eol=lf

# Windows 脚本保持 CRLF，否则 PowerShell 解析异常
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.gguf binary
*.safetensors binary
*.bin  binary

# 生成物（GitHub Linguist 统计忽略）
